---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  description: siteConfig.description,
};
---

<BaseLayout
  title="Ekai Global | Turning Complexity Into Clarity"
  description="AI-native solutions for under-served industries. Ekai Global helps teams simplify operations and accelerate outcomes."
  pathname="/"
  schema={schema}
>
  <section class="container-default py-18 text-center md:py-24">
    <h1 class="mx-auto max-w-4xl text-5xl font-bold leading-tight">
      Turning Complexity into Clarity
    </h1>
    <p
      class="mx-auto mt-4 max-w-3xl text-3xl font-semibold text-[var(--secondary)]"
    >
      At Ekai Global, we co-create AI-native solutions to solve real business
      problems in under-served industries.
    </p>
    <a
      class="focus-outline mt-7 inline-block rounded-full bg-[var(--secondary)] px-9 py-3 text-sm font-semibold text-[var(--primary-contrast)]"
      href="/services"
    >
      Learn More
    </a>
  </section>

  <section class="container-default py-12">
    <h2 class="text-5xl font-bold text-[var(--secondary)]">What We Do</h2>
    <p class="mt-4 max-w-5xl text-[15px] leading-snug text-[var(--muted)]">
      This should be a short description of what we do. This should be a short
      description of what we do. This should be a short description of what we
      do. This should be a short description of what we do. This should be a
      short description of what we do. This should be a short description of
      what we do. This should be a short description of what we do.
    </p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 md:grid-cols-4">
      <article
        class="rounded-3xl bg-[#d7d2c7] px-6 py-5 text-center font-medium"
      >
        Banking
      </article>
      <article
        class="rounded-3xl bg-[#d7d2c7] px-6 py-5 text-center font-medium"
      >
        Insurance
      </article>
      <article
        class="rounded-3xl bg-[#d7d2c7] px-6 py-5 text-center font-medium"
      >
        Retail
      </article>
      <article
        class="rounded-3xl bg-[#d7d2c7] px-6 py-5 text-center font-medium"
      >
        Real Estate
      </article>
    </div>
    <div class="mt-20 flex justify-end">
      <a
        class="focus-outline inline-block rounded-full bg-[var(--accent)] px-7 py-3 text-sm font-semibold text-[var(--accent-contrast)]"
        href="/contact"
      >
        Contact Us
      </a>
    </div>
  </section>

  <section class="relative mt-8 overflow-hidden bg-[var(--background)]">
    <div class="container-default py-10">
      <h2 class="text-5xl font-bold text-[var(--secondary)]">Who We Are</h2>
      <p class="mt-3 max-w-4xl text-[15px] leading-snug text-[var(--muted)]">
        This should be a couple lines about who we are. This should be a couple
        lines about who we are. This should be a couple lines about who we are.
        This should be a couple lines about who we are.
      </p>
      <a
        class="focus-outline mt-8 inline-block rounded-full bg-[var(--secondary)] px-8 py-3 text-sm font-semibold text-[var(--primary-contrast)]"
        href="/about"
      >
        More about us
      </a>
    </div>
    <div
      class="mt-6 h-72 bg-[var(--primary)] md:h-96"
      style="clip-path: polygon(0 94%, 100% 0, 100% 100%, 0 100%);"
    >
    </div>
    <div
      class="pointer-events-none absolute bottom-6 right-[max(1rem,calc((100%-72rem)/2+1rem))]"
    >
      <a
        class="focus-outline pointer-events-auto inline-block rounded-full bg-[var(--accent)] px-7 py-3 text-sm font-semibold text-[var(--accent-contrast)]"
        href="/contact"
      >
        Contact Us
      </a>
    </div>
  </section>

  <section class="container-default py-10">
    <h2 class="text-5xl font-bold text-[var(--secondary)]">Contact Us</h2>
    <form
      class="mt-5 grid gap-5 md:grid-cols-2"
      action={siteConfig.contactFormEndpoint}
      method="POST"
    >
      <div>
        <label for="name" class="text-sm font-semibold text-[var(--muted)]"
          >Name</label
        >
        <input
          id="name"
          name="name"
          type="text"
          placeholder="Enter your name"
          class="focus-outline mt-1 w-full rounded-md border border-[#d5cebc] bg-[#f3efe3] px-3 py-2"
        />
      </div>
      <div>
        <label for="email" class="text-sm font-semibold text-[var(--muted)]"
          >Email</label
        >
        <input
          id="email"
          name="email"
          type="email"
          placeholder="Enter your email"
          class="focus-outline mt-1 w-full rounded-md border border-[#d5cebc] bg-[#f3efe3] px-3 py-2"
        />
      </div>
      <div>
        <label for="reason" class="text-sm font-semibold text-[var(--muted)]"
          >Reason</label
        >
        <select
          id="reason"
          name="reason"
          class="focus-outline mt-1 w-full rounded-md border border-[#d5cebc] bg-[#f3efe3] px-3 py-2"
        >
          <option>Value</option>
          <option>Advisory</option>
          <option>Automation</option>
          <option>Custom Build</option>
        </select>
      </div>
      <div>
        <label for="message" class="text-sm font-semibold text-[var(--muted)]"
          >Message</label
        >
        <textarea
          id="message"
          name="message"
          rows="3"
          placeholder="Value"
          class="focus-outline mt-1 w-full rounded-md border border-[#d5cebc] bg-[#f3efe3] px-3 py-2"
        ></textarea>
      </div>
    </form>
  </section>
</BaseLayout>
