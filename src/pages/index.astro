---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  description: siteConfig.description,
};
---

<BaseLayout
  title="Ekai Global | Turning Complexity Into Clarity"
  description="AI-native solutions for under-served industries. Ekai Global helps teams simplify operations and accelerate outcomes."
  pathname="/"
  schema={schema}
>
  <div class="snap-container">
    <section class="snap-panel">
      <div class="container-default w-full text-center">
        <h1
          class="mx-auto max-w-4xl text-5xl font-bold leading-tight md:text-6xl"
        >
          Turning Complexity into Clarity
        </h1>
        <p
          class="mx-auto mt-5 max-w-3xl text-xl font-semibold text-[var(--secondary)] md:text-2xl"
        >
          At Ekai Global, we co-create AI-native solutions to solve real
          business problems in under-served industries.
        </p>
        <a
          class="focus-outline mt-8 inline-block rounded-full bg-[var(--secondary)] px-9 py-3 text-sm font-semibold text-[var(--primary-contrast)]"
          href="/services"
        >
          Learn More
        </a>
      </div>
    </section>

    <section class="snap-panel">
      <div class="container-default w-full">
        <h2 class="text-4xl font-bold text-[var(--secondary)] md:text-5xl">
          What We Do
        </h2>
        <p class="mt-4 max-w-5xl text-[15px] leading-snug text-[var(--muted)]">
          This should be a short description of what we do. This should be a
          short description of what we do. This should be a short description of
          what we do. This should be a short description of what we do. This
          should be a short description of what we do.
        </p>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 md:grid-cols-4">
          <article
            class="rounded-3xl bg-[#d7d2c7] px-6 py-5 text-center font-medium"
          >
            Banking
          </article>
          <article
            class="rounded-3xl bg-[#d7d2c7] px-6 py-5 text-center font-medium"
          >
            Insurance
          </article>
          <article
            class="rounded-3xl bg-[#d7d2c7] px-6 py-5 text-center font-medium"
          >
            Retail
          </article>
          <article
            class="rounded-3xl bg-[#d7d2c7] px-6 py-5 text-center font-medium"
          >
            Real Estate
          </article>
        </div>
        <div class="mt-12 flex justify-end">
          <a
            class="focus-outline inline-block rounded-full bg-[var(--accent)] px-7 py-3 text-sm font-semibold text-[var(--accent-contrast)]"
            href="/contact"
          >
            Contact Us
          </a>
        </div>
      </div>
    </section>

    <section class="snap-panel relative overflow-hidden">
      <div class="container-default relative z-10 w-full py-8">
        <h2 class="text-4xl font-bold text-[var(--secondary)] md:text-5xl">
          Who We Are
        </h2>
        <p class="mt-4 max-w-4xl text-[15px] leading-snug text-[var(--muted)]">
          This should be a couple lines about who we are. This should be a
          couple lines about who we are. This should be a couple lines about who
          we are. This should be a couple lines about who we are.
        </p>
        <a
          class="focus-outline mt-8 inline-block rounded-full bg-[var(--secondary)] px-8 py-3 text-sm font-semibold text-[var(--primary-contrast)]"
          href="/about"
        >
          More about us
        </a>
      </div>
      <div
        class="absolute inset-x-0 bottom-0 h-72 bg-[var(--primary)] md:h-[65%]"
        style="clip-path: polygon(0 100%, 100% 22%, 100% 100%);"
      >
      </div>
      <div class="pointer-events-none absolute bottom-8 right-8 md:right-12">
        <a
          class="focus-outline pointer-events-auto inline-block rounded-full bg-[var(--accent)] px-7 py-3 text-sm font-semibold text-[var(--accent-contrast)]"
          href="/contact"
        >
          Contact Us
        </a>
      </div>
    </section>

    <section class="snap-panel">
      <div class="container-default w-full">
        <h2 class="text-4xl font-bold text-[var(--secondary)] md:text-5xl">
          Contact Us
        </h2>
        <form
          data-stub-contact-form
          class="mt-6 grid gap-5 md:grid-cols-2"
          method="POST"
        >
          <div>
            <label for="name" class="text-sm font-semibold text-[var(--muted)]"
              >Name</label
            >
            <input
              id="name"
              name="name"
              type="text"
              placeholder="Enter your name"
              class="focus-outline mt-1 w-full rounded-md border border-[#d5cebc] bg-[#f3efe3] px-3 py-2 text-[var(--text)] placeholder:text-[var(--muted)]"
            />
          </div>
          <div>
            <label for="email" class="text-sm font-semibold text-[var(--muted)]"
              >Email</label
            >
            <input
              id="email"
              name="email"
              type="email"
              placeholder="Enter your email"
              class="focus-outline mt-1 w-full rounded-md border border-[#d5cebc] bg-[#f3efe3] px-3 py-2 text-[var(--text)] placeholder:text-[var(--muted)]"
            />
          </div>
          <div>
            <label
              for="reason"
              class="text-sm font-semibold text-[var(--muted)]">Reason</label
            >
            <select
              id="reason"
              name="reason"
              class="focus-outline mt-1 w-full rounded-md border border-[#d5cebc] bg-[#f3efe3] px-3 py-2 text-[var(--text)]"
            >
              <option>Value</option>
              <option>Advisory</option>
              <option>Automation</option>
              <option>Custom Build</option>
            </select>
          </div>
          <div>
            <label
              for="message"
              class="text-sm font-semibold text-[var(--muted)]">Message</label
            >
            <textarea
              id="message"
              name="message"
              rows="3"
              placeholder="Value"
              class="focus-outline mt-1 w-full rounded-md border border-[#d5cebc] bg-[#f3efe3] px-3 py-2 text-[var(--text)] placeholder:text-[var(--muted)]"
            ></textarea>
          </div>
          <button
            type="submit"
            class="focus-outline md:col-span-2 inline-flex w-fit rounded-full bg-[var(--accent)] px-7 py-3 text-sm font-semibold text-[var(--accent-contrast)]"
          >
            Send Message
          </button>
          <p
            data-form-status
            class="hidden md:col-span-2 rounded-md bg-[var(--surface)] px-4 py-3 text-sm font-medium text-[var(--accent)]"
          >
            Thank you. Your message has been captured (stub). We will wire this
            to email delivery next.
          </p>
        </form>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  const forms = document.querySelectorAll("[data-stub-contact-form]");
  forms.forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const status = form.querySelector("[data-form-status]");
      if (status) {
        status.classList.remove("hidden");
      }
      form.reset();
    });
  });
</script>
