---
type Props = {
  title: string;
  description: string;
  ctaLabel?: string;
  ctaHref?: string;
};

const { title, description, ctaLabel, ctaHref } = Astro.props;
---

<section class="container-default py-16 md:py-24">
  <div class="card p-8 md:p-12">
    <p
      class="mb-4 text-sm font-semibold uppercase tracking-wide text-[var(--accent)]"
    >
      Ekai Global
    </p>
    <h1 class="max-w-3xl text-4xl font-bold leading-tight md:text-5xl">
      {title}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-[var(--muted)]">{description}</p>
    {
      ctaLabel && ctaHref && (
        <a
          class="focus-outline mt-8 inline-block rounded-md bg-[var(--accent)] px-6 py-3 font-semibold text-[var(--accent-contrast)] transition hover:opacity-90"
          href={ctaHref}
        >
          {ctaLabel}
        </a>
      )
    }
  </div>
</section>
