---
type Props = {
  heading: string;
  description?: string;
};

const { heading, description } = Astro.props;
---

<section class="container-default py-10">
  <h2 class="text-3xl font-bold">{heading}</h2>
  {
    description && (
      <p class="mt-3 max-w-3xl text-[var(--muted)]">{description}</p>
    )
  }
  <div class="mt-6">
    <slot />
  </div>
</section>
