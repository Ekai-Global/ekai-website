---
import { siteConfig } from "../../config/site";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--primary)] text-[var(--primary-contrast)]"
>
  <div class="container-default flex items-center justify-between gap-4 py-3">
    <a href="/" class="focus-outline flex items-center gap-3 text-lg font-bold">
      <img
        src="/logo-ekai.png"
        alt="Ekai logo"
        class="h-9 w-9 rounded-sm bg-[var(--surface)] object-cover"
        loading="eager"
      />
      <span class="text-[var(--primary-contrast)]">{siteConfig.name}</span>
    </a>
    <nav aria-label="Main navigation">
      <ul class="flex items-center gap-6 text-sm font-semibold">
        {
          siteConfig.navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="focus-outline rounded-md px-1 py-1 text-[var(--primary-contrast)]/70 transition hover:text-[var(--primary-contrast)]"
                aria-current={pathname === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
