---
import { siteConfig } from "../../config/site";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--primary)] text-[var(--primary-contrast)]"
>
  <div
    class="container-default flex items-center justify-between gap-2 py-3 md:gap-4"
  >
    <a
      href="/"
      class="focus-outline flex min-w-0 items-center gap-2 text-base font-bold md:gap-3 md:text-lg"
    >
      <img
        src="/logo-ekai.png"
        alt="Ekai logo"
        class="h-8 w-8 rounded-sm bg-[var(--surface)] object-cover md:h-9 md:w-9"
        loading="eager"
      />
      <span class="truncate text-[var(--primary-contrast)]"
        >{siteConfig.name}</span
      >
    </a>
    <nav aria-label="Main navigation">
      <ul
        class="flex items-center gap-3 text-xs font-semibold md:gap-6 md:text-sm"
      >
        {
          siteConfig.navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="focus-outline rounded-md px-1 py-1 text-[var(--primary-contrast)]/70 transition hover:text-[var(--primary-contrast)]"
                aria-current={pathname === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
